# Environment template for the QLever LUX middle tier.
#
# Copy to .env in the directory the server is started from:
#
#     cp env.template .env
#
# MTConfig calls load_dotenv() at import, which reads .env from the working
# directory. Variables already set in the shell win over the file, so .env acts
# as a set of defaults. Every value below is the built-in default, so a .env
# copied unchanged from this template behaves exactly like no .env at all.
#
# Most of these also have a command line flag, which overrides both. The flag
# name is the lower-cased variable name without the QLMT_ prefix, with
# underscores as dashes, unless noted otherwise below. Passwords are the
# exception: --pgpass and --qlpass abort at startup, because command lines are
# visible to other users via ps. Set QLMT_PGPASS here instead.
#
# The on/off settings use store_true flags, so the command line can only switch
# one on. To switch off something that defaults to on - stopwords, httpx, the
# disk HAL cache - set the variable to false here.
#
# .env is git-ignored; this template is not. Keep real credentials out of it.


# --- File locations -----------------------------------------------------------

# Path to config file directory
QLMT_CONFIG_PATH=config

# Path to queries directory
QLMT_QUERIES_PATH=queries

# Path to HAL cache directory
QLMT_HAL_CACHE_PATH=hal_cache


# --- PostgreSQL record cache --------------------------------------------------

# Postgres host; empty connects over the local unix socket
QLMT_PGHOST=

# Postgres port
QLMT_PGPORT=5432

# Postgres username
# Defaults to the current OS user, so it is left unset rather than written out.
# QLMT_PGUSER=

# Postgres password; no command line flag, --pgpass aborts at startup
QLMT_PGPASS=

# Postgres database
# Defaults to the current OS user, so it is left unset rather than written out.
# QLMT_PGDB=

# Postgres records table
QLMT_PGTABLE=lux_data_cache

# Postgres table holding cached HAL links; no command line flag
QLMT_PGTABLE_HAL=hal_data_cache

# Postgres sslmode; no command line flag
QLMT_PGSSLMODE=require

# Use postgres data cache
QLMT_USE_PG_DATA_CACHE=false

# Use postgres hal cache
# The command line flag is --use-postgres-hal-cache.
QLMT_USE_POSTGRES_HAL_CACHE=false


# --- LMDB record cache --------------------------------------------------------

# Path to lmdb cache; empty disables the LMDB cache entirely
QLMT_LMDB_PATH=

# Use lmdb data cache
# Ignored unless QLMT_LMDB_PATH above is also set.
QLMT_USE_LMDB_DATA_CACHE=false


# --- Disk HAL cache -----------------------------------------------------------

# Use disk hal cache
# Writes to QLMT_HAL_CACHE_PATH. Set false to recompute HAL links per request.
QLMT_USE_DISK_HAL_CACHE=true


# --- QLever SPARQL endpoint ---------------------------------------------------

# Qlever protocol for SPARQL
QLMT_QLPROTO=http

# Qlever host for SPARQL
QLMT_QLHOST=localhost

# Qlever port for SPARQL
QLMT_QLPORT=7010

# Qlever path for SPARQL
QLMT_QLPATH=sparql


# --- Where the middle tier listens --------------------------------------------

# HTTP/HTTPS for middletier
QLMT_MTPROTO=https

# Middletier listen host
QLMT_MTHOST=0.0.0.0

# Middletier listen port
QLMT_MTPORT=5000

# Middletier listen path
QLMT_MTPATH=

# prefix for cert files; serve.py reads files/<name>.pem and files/<name>-key.pem
QLMT_CERTNAME=qleverlux


# --- URI substitution ---------------------------------------------------------
#
# Records are stored under the data URI and rewritten to this deployment's own
# URI on the way out. The external parts below are assembled into that URI.

# Data URI for URI substitution
QLMT_DATAURI=https://lux.collections.yale.edu/

# Protocol for URI substitution
QLMT_REPLACE_PROTO=https

# Host for URI substitution; the command line flag is --replace-host
QLMT_EXTERNAL_HOST=qleverlux.collections.yale.edu

# Port for replacement; -1 means no port in the external URI.
# The command line flag is --replace-port.
QLMT_EXTERNAL_PORT=-1

# Path for URI substitution; the command line flag is --replace-path
QLMT_EXTERNAL_PATH=


# --- Search behaviour ---------------------------------------------------------

# Path to search configuration file
QLMT_SEARCH_CONFIG=

# Page length for pagination
QLMT_PAGELENGTH=20

# Which source unit, if any, to filter for
# One of YPM, YCBA, YUAG, PMC, IPCH. Empty serves everything.
QLMT_PORTAL=

# Use stopwords
# Strips config/stopwords.json terms from free-text queries.
QLMT_USESTOPWORDS=true

# Log level for uvicorn
QLMT_LOGLEVEL=info


# --- AI query translation -----------------------------------------------------

# Enable AI translation; the command line flag is --ai-translate-enabled
QLMT_AI_TRANSLATE=true

# AI translate model
QLMT_AI_TRANSLATE_MODEL=

# AI translate project
QLMT_AI_TRANSLATE_PROJECT=

# AI translate region
QLMT_AI_TRANSLATE_REGION=

# AI translate API key
QLMT_AI_TRANSLATE_API_KEY=

# AI translate API endpoint
QLMT_AI_TRANSLATE_API_ENDPOINT=

# AI thinking budget in tokens
QLMT_AI_THINKING_BUDGET=2000


# --- Connections, queues and limits -------------------------------------------

# Use httpx for http2 connections to qlever; set false to use aiohttp instead
QLMT_USEHTTPX=true

# Timeout for qlever requests, in seconds
QLMT_QLEVER_TIMEOUT=30

# Max connections to QLever
QLMT_MAX_QLEVER_CONNECTIONS=20

# Maximum number of open requests to qlever, beyond which requests are shed
# The command line flag is --max-qlever-requests.
QLMT_MAX_OPEN_REQUESTS=64

# Backlog size for the queue
QLMT_BACKLOG=512

# Size of the queue
QLMT_QUEUE_SIZE=128

# Maximum size of the application queue
# The command line flag is --max-app-queue-size.
QLMT_APP_QUEUE_SIZE=128

# Number of worker processes; only workers.py runs more than one
QLMT_WORKERS=4

# Timeout for read operations, in seconds
QLMT_READ_TIMEOUT=30
