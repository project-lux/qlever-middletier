+def page_aligned_copy(data: bytes, *, offset: int = 0) -> memoryview:
+    """*data* copied *offset* bytes past a page boundary - where a memory-mapped store, such as an
+    LMDB value padded to its page, hands a checkpoint over."""
+    page = mmap.PAGESIZE
+    backing = np.zeros(len(data) + offset + 2 * page, dtype=np.uint8)
+    start = (-backing.ctypes.data) % page + offset
+    backing[start : start + len(data)] = np.frombuffer(data, dtype=np.uint8)
+    return memoryview(backing)[start : start + len(data)]
+
+
+def searched_columns(index: DenseIndex, queries, **options) -> tuple[npt.NDArray, ...]:
+    """The keys, distances and counts one search answers, copied out of their arena. The search runs
+    on the calling thread, whose walks break ties in one order every time, unlike a pool's."""
+    found = index.search(queries, 10, Arena(), expansion_factor=64, **options)
+    return keys_to_integers(np.array(found.keys)), np.array(found.distances), np.array(found.counts)
+
+
+def assert_same_matches(got: tuple[npt.NDArray, ...], expected: tuple[npt.NDArray, ...]) -> None:
+    """The same keys, distances and counts, element for element."""
+    for got_column, expected_column in zip(got, expected, strict=True):
+        np.testing.assert_array_equal(got_column, expected_column)
+
